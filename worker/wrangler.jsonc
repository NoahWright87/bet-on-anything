{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bet-on-anything",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "durable_objects": {
    "bindings": [{ "name": "TABLE", "class_name": "Table" }]
  },
  // The free plan only supports SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],

  // Comma-separated browser origins allowed to call the API (CORS) and open WebSockets.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://bet-on-anything.netlify.app"
  }
}
